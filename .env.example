# ---- Shopee Affiliate Open API ----
# Solicite em https://affiliate.shopee.com.br (menu Open API). Aprovação leva ~5-15 dias.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
# Endpoint do programa brasileiro. Ajuste o domínio para outros países.
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# ---- Mercado Livre (API pública, sem link de afiliado programático) ----
# Site MLB = Brasil
MELI_SITE=MLB
# Token opcional (a busca pública funciona sem, mas com rate limit menor)
MELI_ACCESS_TOKEN=

# ---- Ranking ----
# Pesos do score (normalizados por lote antes de aplicar)
SCORE_W_COMMISSION=0.40
SCORE_W_SALES=0.30
SCORE_W_DISCOUNT=0.20
SCORE_W_RATING=0.10
# Não reenviar a mesma oferta por N dias
DEDUPE_DAYS=7

# ---- Disparo ----
# console = imprime mensagem pronta para colar no grupo (semiautomático, zero risco)
# telegram = envia via Bot API oficial
DISPATCH=console
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Armazenamento ----
DB_PATH=data/iqlinks.db
